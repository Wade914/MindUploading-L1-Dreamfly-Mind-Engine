# DreamFly 前端环境配置
# 环境选择: development | production
VUE_APP_ENVIRONMENT=production

# 调试模式: true | false
VUE_APP_DEBUG=false

# 开发环境配置
VUE_APP_DEV_API_BASE_URL=http://localhost:8000
VUE_APP_DEV_FRONTEND_URL=http://localhost:5173

# 生产环境配置
VUE_APP_PROD_API_BASE_URL=http://api.upme.cool
VUE_APP_PROD_FRONTEND_URL=http://upme.cool

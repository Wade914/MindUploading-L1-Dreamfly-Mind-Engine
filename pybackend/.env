# DreamFly 环境配置文件

# 应用配置
APP_NAME=DreamFly API
APP_VERSION=1.0.0
DEBUG=false

# 数据库配置
DATABASE_URL=sqlite+aiosqlite:///./dreamfly.db
DATABASE_DIR=./pybackend/database

# 目录配置
UPLOAD_DIR=./pybackend/uploads
MINDS_DIR=./pybackend/database/minds
LOG_DIR=./pybackend/logs

# 上传子目录配置
UPLOAD_THOUGHT_DIR=thought
UPLOAD_VOICE_DIR=voice
UPLOAD_IMAGE_DIR=image
UPLOAD_DOCUMENT_DIR=documents

# 文件大小限制配置
MAX_FILE_SIZE=20971520
MAX_THOUGHT_SIZE=5242880
MAX_VOICE_SIZE=10485760
MAX_IMAGE_SIZE=20971520
MAX_DOCUMENT_SIZE=10485760

# CORS配置
CORS_ORIGINS=["https://upme.cool"]

# AI模型配置
SILICONFLOW_API_KEY=sk-uxhaanvyqaidjbvytywniwjyaixqbevvhqkkjcjjvuogvqat
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1
DEEPSEEK_MODEL=deepseek-ai/DeepSeek-V3
COSYVOICE_MODEL=FunAudioLLM/CosyVoice2-0.5B

# AI请求配置
AI_TEMPERATURE=0.7
AI_MAX_TOKENS=1024
AI_STREAM=true

# JWT认证配置
SECRET_KEY=dreamfly_secret_key_2025
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 服务器配置
HOST=0.0.0.0
PORT=8000